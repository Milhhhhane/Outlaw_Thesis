  "dungeons": {
    "ember_wastes": {
      "name": "Landes de braise",
      "text": "Des chiens de cendre gardent la route. Leur matrone attend au bout."
    },
    "drowned_halls": {
      "name": "Salles englouties",
      "text": "Le courant vous ralentit dès l'entrée : laissez venir, puis frappez."
    },
    "thorn_maze": {
      "name": "Dédale de ronces",
      "text": "Chaque coup porté vous écorche : choisissez peu de coups, mais lourds."
    },
    "cinder_citadel": {
      "name": "Citadelle de cendre",
      "text": "L'air brûle : chaque fin de tour coûte un peu de vie. Finissez vite."
    },
    "sunken_spire": {
      "name": "Flèche engloutie",
      "text": "Chaque sort ennemi se protège d'un bouclier : percez avant de frapper fort."
    },
    "verdant_crown": {
      "name": "Couronne verdoyante",
      "text": "Les spores vous engourdissent au départ : survivez aux premiers tours."
    },
    "broken_crossing": {
      "name": "Carrefour brisé",
      "text": "Tous les éléments à la fois, et deux anciens gardiens au bout du chemin."
    },
    "salt_flats": {
      "name": "Salines blêmes",
      "text": "La chaleur trouble la garde : votre défense flanche à chaque tour. Deux maîtres des lieux vous attendent."
    },
    "obsidian_pass": {
      "name": "Col d'obsidienne",
      "text": "Les éclats de verre brûlent à chaque coup reçu. Le tyran et la matrone tiennent le col ensemble."
    },
    "hollow_throne": {
      "name": "Trône creux",
      "text": "Le trône aspire votre réserve dès l'entrée. Trois colosses pour un dernier siège."
    },
    "frost_strand": {
      "name": "Grève gelée",
      "text": "Le givre couvre chaque ennemi d'un premier bouclier. Une gueule de glace garde la grève."
    },
    "bog_mire": {
      "name": "Tourbière sombre",
      "text": "La vase colle aux bottes : vos grands sorts vous ralentissent. Le troll se nourrit des chutes."
    },
    "ember_forge": {
      "name": "Forge des braises",
      "text": "Au premier coup reçu, chaque diablotin s'enrage. Frappez fort, ou pas du tout."
    },
    "glacier_vault": {
      "name": "Caveau glaciaire",
      "text": "À mi-vie, la glace se referme sur les gardiens. Gardez de quoi percer la carapace."
    },
    "rotwood": {
      "name": "Bois pourrissant",
      "text": "Le mycélium soigne les plus faibles à chaque tour. Abattez-les un par un, vite."
    },
    "twin_rivers": {
      "name": "Confluent",
      "text": "La fièvre gagne les deux rives : tout le monde frappe plus fort, eux plus encore."
    },
    "ash_caldera": {
      "name": "Caldeira de cendre",
      "text": "Un vent de cendres brûle le plus fragile à chaque tour ennemi. Le titan attise les siens."
    },
    "frozen_abyss": {
      "name": "Abîme gelé",
      "text": "Le verglas retarde quiconque lance son ultime. La gueule et l'hydre règnent sous la glace."
    },
    "elder_swamp": {
      "name": "Marais ancestral",
      "text": "Chaque coup reçu vous enlace de racines qui ralentissent. Deux colosses du marais au bout."
    },
    "eclipse_keep": {
      "name": "Donjon de l'éclipse",
      "text": "Quand l'un d'eux tombe, les autres se pressent et se protègent. Les trois maîtres de la région vous attendent."
    }
  }
}
