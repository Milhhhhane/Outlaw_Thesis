    "soufre": {
      "name": "Soufre",
      "thesis": "Damner : ce qui brûle agit plus lentement et prend plus cher."
    },
    "torrent": {
      "name": "Torrent",
      "thesis": "Enchaîner : chaque ennemi abattu offre un tour de plus."
